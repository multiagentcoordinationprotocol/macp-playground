{
  "packs/claims/pack.yaml": {
    "apiVersion": "scenarios.macp.dev/v1",
    "kind": "ScenarioPack",
    "metadata": {
      "slug": "claims",
      "name": "Claims",
      "description": "Insurance claims review and adjudication demos",
      "tags": [
        "claims",
        "insurance",
        "review",
        "demo"
      ]
    }
  },
  "packs/claims/scenarios/auto-claim-review/1.0.0/scenario.yaml": {
    "apiVersion": "scenarios.macp.dev/v1",
    "kind": "ScenarioVersion",
    "metadata": {
      "pack": "claims",
      "scenario": "auto-claim-review",
      "version": "1.0.0",
      "name": "Auto Claim Review",
      "summary": "Claims validation, fraud investigation, compliance review, and customer advocacy agents collaborate on an auto insurance claim.",
      "tags": [
        "claims",
        "insurance",
        "fraud",
        "compliance",
        "demo",
        "mixed-framework"
      ]
    },
    "spec": {
      "runtime": {
        "kind": "rust",
        "version": "v1"
      },
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "claimId": {
              "type": "string",
              "default": "CLM-3001"
            },
            "claimAmount": {
              "type": "number",
              "default": 8500,
              "minimum": 100
            },
            "policyAge": {
              "type": "integer",
              "default": 24,
              "minimum": 0,
              "description": "Age of the policy in months (e.g. 24 = two years)."
            },
            "priorClaims": {
              "type": "integer",
              "default": 1,
              "minimum": 0
            },
            "isHighValuePolicy": {
              "type": "boolean",
              "default": false
            },
            "incidentSeverity": {
              "type": "string",
              "default": "moderate",
              "enum": [
                "minor",
                "moderate",
                "severe",
                "total_loss"
              ]
            }
          },
          "required": [
            "claimAmount",
            "policyAge",
            "priorClaims",
            "isHighValuePolicy",
            "incidentSeverity"
          ]
        }
      },
      "launch": {
        "modeName": "macp.mode.decision.v1",
        "modeVersion": "1.0.0",
        "configurationVersion": "config.default",
        "policyVersion": "policy.claims.majority",
        "policyHints": {
          "type": "majority",
          "description": "Simple majority vote with 2-voter quorum for claims review",
          "threshold": 0.5,
          "vetoEnabled": false,
          "vetoThreshold": 1,
          "minimumConfidence": 0,
          "designatedRoles": []
        },
        "ttlMs": 300000,
        "initiatorParticipantId": "risk-agent",
        "participants": [
          {
            "id": "fraud-agent",
            "role": "claims-validator",
            "agentRef": "fraud-agent"
          },
          {
            "id": "growth-agent",
            "role": "customer-advocate",
            "agentRef": "growth-agent"
          },
          {
            "id": "compliance-agent",
            "role": "compliance-reviewer",
            "agentRef": "compliance-agent"
          },
          {
            "id": "risk-agent",
            "role": "risk",
            "agentRef": "risk-agent"
          }
        ],
        "commitments": [
          {
            "id": "claim-validated",
            "title": "Claim validated",
            "description": "Claims validator has confirmed documentation and policy coverage for the incident.",
            "requiredRoles": [
              "claims-validator"
            ],
            "policyRef": "policy.claims.majority"
          },
          {
            "id": "compliance-reviewed",
            "title": "Compliance review complete",
            "description": "Compliance reviewer has confirmed the claim meets regulatory handling requirements.",
            "requiredRoles": [
              "compliance-reviewer"
            ],
            "policyRef": "policy.claims.majority"
          },
          {
            "id": "claim-decision",
            "title": "Claim decision finalized",
            "description": "Risk coordinator has reconciled inputs and issued an approve / investigate / deny decision.",
            "requiredRoles": [
              "risk"
            ],
            "policyRef": "policy.claims.majority"
          }
        ],
        "contextTemplate": {
          "claimId": "{{ inputs.claimId }}",
          "claimAmount": "{{ inputs.claimAmount }}",
          "policyAge": "{{ inputs.policyAge }}",
          "priorClaims": "{{ inputs.priorClaims }}",
          "isHighValuePolicy": "{{ inputs.isHighValuePolicy }}",
          "incidentSeverity": "{{ inputs.incidentSeverity }}"
        },
        "metadataTemplate": {
          "demoType": "claims-review",
          "decisionOwner": "risk-agent",
          "specialists": [
            "fraud-agent",
            "growth-agent",
            "compliance-agent"
          ],
          "intent": "review auto insurance claim with multi-framework agents"
        },
        "kickoffTemplate": [
          {
            "from": "risk-agent",
            "to": [
              "fraud-agent",
              "growth-agent",
              "compliance-agent"
            ],
            "kind": "proposal",
            "messageType": "Proposal",
            "payloadEnvelope": {
              "encoding": "proto",
              "proto": {
                "typeName": "macp.modes.decision.v1.ProposalPayload",
                "value": {
                  "proposal_id": "{{ inputs.claimId }}-review",
                  "option": "evaluate_claim",
                  "rationale": "Decide whether to approve, investigate further, or deny the claim."
                }
              }
            }
          }
        ]
      },
      "execution": {
        "tags": [
          "demo",
          "claims",
          "mixed-framework",
          "examples"
        ],
        "requester": {
          "actorId": "macp-playground",
          "actorType": "service"
        }
      },
      "outputs": {
        "expectedDecisionKinds": [
          "approve",
          "investigate",
          "deny"
        ],
        "expectedSignals": [
          "suspicious_pattern",
          "prior_claims_history",
          "high_value_policy",
          "severity_assessment"
        ]
      }
    }
  },
  "packs/claims/scenarios/auto-claim-review/1.0.0/templates/default.yaml": {
    "apiVersion": "scenarios.macp.dev/v1",
    "kind": "ScenarioTemplate",
    "metadata": {
      "scenarioVersion": "claims/auto-claim-review@1.0.0",
      "slug": "default",
      "name": "Default"
    },
    "spec": {
      "defaults": {
        "claimAmount": 8500,
        "policyAge": 24,
        "priorClaims": 1,
        "isHighValuePolicy": false,
        "incidentSeverity": "moderate"
      }
    }
  },
