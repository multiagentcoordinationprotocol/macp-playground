{
  "name": "macp-playground",
  "version": "0.2.0",
  "private": true,
  "description": "MACP Playground — file-backed showcase service for MACP demos, with scenario compilation and example-agent bootstrap.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint --max-warnings=0 \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"jest.config.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"jest.config.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"jest.config.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\" \"jest.config.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts",
    "test:integration": "jest --config test/jest.integration.config.ts --runInBand",
    "test:integration:docker": "INTEGRATION_CONTROL_PLANE=docker jest --config test/jest.integration.config.ts --runInBand",
    "test:integration:remote": "INTEGRATION_CONTROL_PLANE=remote jest --config test/jest.integration.config.ts --runInBand",
    "scenario": "ts-node scripts/scenario.ts",
    "scenario:validate": "ts-node scripts/scenario.ts validate",
    "scenario:dry-run": "ts-node scripts/scenario.ts dry-run",
    "scenario:new": "ts-node scripts/scenario.ts new",
    "scenario:lint": "ts-node scripts/scenario.ts lint",
    "schemas:sync": "ts-node scripts/schemas-sync.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "js-yaml": "^5.4.2",
    "macp-sdk-typescript": "^0.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "commander": "^4.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^30.5.0",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
