# Doppler is the source of truth for this service's configuration:
#   project macp-playground, config dev (local), prd (Railway production).
#   doppler setup --project macp-playground --config dev   # once per checkout
#   doppler run -- npm run start:dev
# The service does not read .env itself. Without Doppler access, copy this
# file to .env (gitignored) and load it into your shell: set -a; . ./.env; set +a
# The hosted service is synced from Doppler by deploy/doppler-sync.sh.

# -- HTTP --
PORT=3000
HOST=0.0.0.0
# Comma-separated origins. Supports wildcards for Vercel preview URLs.
# Examples:
#   CORS_ORIGIN=https://myapp.vercel.app
#   CORS_ORIGIN=https://myapp.vercel.app,https://myapp-*.vercel.app
#   CORS_ORIGIN=*
CORS_ORIGIN=http://localhost:3000

# -- Packs --
PACKS_DIR=./packs

# -- Cache --
REGISTRY_CACHE_TTL_MS=0

# -- Example agents --
AUTO_BOOTSTRAP_EXAMPLE_AGENTS=true
REGISTER_POLICIES_ON_LAUNCH=true
EXAMPLE_AGENT_PYTHON_PATH=python3
EXAMPLE_AGENT_NODE_PATH=

# -- Direct-agent-auth (RFC-MACP-0004) --
# gRPC endpoint the spawned agents dial directly.
MACP_RUNTIME_ADDRESS=
MACP_RUNTIME_TLS=true
# Must be set to `true` when MACP_RUNTIME_TLS=false. Local dev only.
MACP_RUNTIME_ALLOW_INSECURE=false
# Local HTTP listener agents bind so the control-plane can POST cancel requests
# (RFC-MACP-0001 §7.2 Option A). Empty host disables the callback server.
MACP_CANCEL_CALLBACK_HOST=127.0.0.1
MACP_CANCEL_CALLBACK_PORT_BASE=0
MACP_CANCEL_CALLBACK_PATH=/agent/cancel

# -- Auth (AUTH-2 JWT minting) --
# Required — every spawn mints a short-lived RS256 JWT via POST /tokens.
MACP_AUTH_SERVICE_URL=http://localhost:3200
MACP_AUTH_SERVICE_TIMEOUT_MS=5000
MACP_AUTH_TOKEN_TTL_SECONDS=3600
# Optional per-sender scope overrides; deep-merged onto role-derived defaults.
MACP_AUTH_SCOPES_JSON=

# -- Control-plane (CP-1 run registration, optional) --
# When set, /examples/run registers each run via POST /runs (best-effort, never fails the run).
# Empty disables submission.
MACP_CONTROL_PLANE_URL=
MACP_CONTROL_PLANE_TIMEOUT_MS=5000
# Sent as `Authorization: Bearer <key>`; must match the control-plane's AUTH_API_KEYS.
MACP_CONTROL_PLANE_API_KEY=

# API-key auth on the macp-playground HTTP surface (separate from agent JWTs). Every route but
# /healthz needs it; required when NODE_ENV=production. Empty: open (local development only).
AUTH_API_KEYS=
# Proxies in front that append to X-Forwarded-For (Railway: 1). 0: use the socket peer.
TRUSTED_PROXY_HOPS=0

# -- LLM agents and their launch limits (docs/deployment.md § LLM launch limits) --
# PLAYGROUND_ALLOW_LLM=1
# LLM_LIMIT_PER_IP_BURST=5
# LLM_LIMIT_PER_IP_BURST_WINDOW_MS=3600000
# LLM_LIMIT_PER_IP_DAILY=20
# LLM_LIMIT_GLOBAL_DAILY=200
# LLM_LIMIT_GLOBAL_MONTHLY=2000
# LLM_LIMIT_ACTION=fallback          # or reject (429)
# Postgres for the counters; empty = in-memory (resets on restart, per replica). Required in
# production when PLAYGROUND_ALLOW_LLM is set.
# LLM_USAGE_DATABASE_URL=postgres://user:pass@host:5432/db

# -- Logging --
LOG_LEVEL=info

# -- Environment --
NODE_ENV=development
